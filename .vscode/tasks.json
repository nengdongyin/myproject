{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile Project",
      "type": "shell",
      "command": "${command:raspberry-pi-pico.getWestPath}",
      "args": [
        "build",
        "-p",
        "auto",
        "-b",
        "rpi_pico2/rp2350a/m33/w",
        "-d",
        "\"${workspaceFolder}/build\"",
        "\"${workspaceFolder}\"",
        "--",
        "-DOPENOCD=${command:raspberry-pi-pico.getOpenOCDRoot}/openocd",
        "-DOPENOCD_DEFAULT_PATH=${command:raspberry-pi-pico.getOpenOCDRoot}/scripts"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": "$gcc",
      "options": {
        "cwd": "${command:raspberry-pi-pico.getZephyrWorkspacePath}",
        "env": {
          "PATH": "${command:raspberry-pi-pico.getGitPath}:${env:PATH}:"
        }
      },
      "windows": {
        "options": {
          "env": {
            "Path": "${command:raspberry-pi-pico.getGitPath};${env:Path};"
          },
          "shell": {
            "executable": "cmd.exe",
            "args": [
              "/d",
              "/c"
            ]
          }
        }
      }
    },
    {
      "label": "Flash",
      "type": "shell",
      "group": {
        "kind": "build"
      },
      "command": "\"${command:raspberry-pi-pico.getWestPath}\"",
      "args": [
        "flash",
        "--build-dir",
        "\"${workspaceFolder}/build\""
      ],
      "options": {
        "cwd": "${command:raspberry-pi-pico.getZephyrWorkspacePath}"
      }
    },
    {
      "label": "Run Project",
      "type": "shell",
      "command": "\"${command:raspberry-pi-pico.getPicotoolPath}\"",
      "args": [
        "load",
        "\"${workspaceFolder}/build/zephyr/zephyr.elf\"",
        "-fx"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": [],
      "dependsOrder": "sequence",
      "dependsOn": "Compile Project"
    },
    {
      "label": "Build PC Tests",
      "type": "shell",
      "command": "C:/msys64/ucrt64/bin/gcc.exe",
      "args": [
        "@test_build/build.rsp"
      ],
      "group": {
        "kind": "build"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": "$gcc",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "Path": "C:\\msys64\\ucrt64\\bin;${env:Path}"
        }
      }
    },
    {
      "label": "Run PC Tests",
      "type": "shell",
      "command": "${workspaceFolder}/test_build/pc_test_runner.exe",
      "args": [],
      "group": {
        "kind": "test"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "dependsOn": "Build PC Tests"
    },
    {
      "label": "Check Config Overlay",
      "type": "shell",
      "command": "python",
      "args": [
        "tools/check_config_overlay.py"
      ],
      "group": {
        "kind": "test"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
